{
  "name": "@agents-manager/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "agents-manager": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "typecheck": "tsgo --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "clean": "bunx rimraf dist .turbo"
  },
  "dependencies": {
    "@agents-manager/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
