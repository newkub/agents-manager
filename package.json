{
  "name": "agents-manager",
  "version": "0.1.0",
  "description": "Agent Manager — web and desktop app for managing AI agent skills, workflows, and MCP servers",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "prepare": "bunx lefthook install",
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview",
    "server": "bun --hot src/server/index.ts",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "ci": "bun run verify && bun run build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "clean": "bunx rimraf dist dist-ssr src-tauri/target"
  },
  "dependencies": {
    "@orpc/client": "^1.15.0",
    "@orpc/server": "^1.15.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tanstack/solid-router": "^1.170.30",
    "dompurify": "^3.4.14",
    "elysia": "^1.4.29",
    "marked": "^18.0.11",
    "shiki": "^4.4.3",
    "solid-js": "^1.9.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@iconify-json/lucide": "^1.2.126",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.4",
    "bun-types": "^1.4.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "typescript": "^7.0.2",
    "unocss": "^66.8.1",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ]
}
