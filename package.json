{
  "name": "agents-manager",
  "version": "0.1.0",
  "description": "Agent Manager — web and desktop app for managing AI agent skills, workflows, and MCP servers",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "prepare": "bunx lefthook install",
    "dev": "vite --port 5173 --host",
    "build": "vite build",
    "preview": "vite preview",
    "server": "bun --hot src/server/index.ts",
    "start": "bun src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "verify": "bun run lint && bun run typecheck && bun run test",
    "ci": "bun run verify && bun run build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "clean": "bunx rimraf dist dist-ssr src-tauri/target"
  },
  "dependencies": {
    "@orpc/client": "^1.14.1",
    "@orpc/server": "^1.14.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tanstack/solid-router": "^1.170.30",
    "dompurify": "^3.4.9",
    "elysia": "^1.4.29",
    "marked": "^18.0.5",
    "shiki": "^4.2.0",
    "solid-js": "^1.9.13",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@iconify-json/lucide": "^1.2.111",
    "@solidjs/testing-library": "^0.8.10",
    "@tauri-apps/cli": "^2.11.2",
    "bun-types": "^1.3.14",
    "jsdom": "^29.1.1",
    "lefthook": "^2.1.9",
    "typescript": "^5.8.2",
    "unocss": "^66.7.0",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.8"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ]
}
